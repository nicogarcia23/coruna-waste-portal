          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, (5 + MOD(EXTRACT(DAY FROM ts)::int, 7))::double precision AS value FROM generate_series(now() - interval '29 days', now(), interval '1 day') AS ts ORDER BY 1",
